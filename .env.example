# --- consultation form ---
# Google Apps Script web-app URL that appends enquiries to the sheet.
# See docs/google-sheet-webhook.md. Leave blank to no-op (still validated + logged).
SHEETS_WEBHOOK_URL=

# ERP lead-intake webhook. Leave blank to no-op.
ERP_WEBHOOK_URL=

# --- product analytics, via PostHog (leave blank to no-op) ---
# Same project as apps/web — see apps/web/.env.example for the key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
